GEMINI_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only DREAMKey Stripe configuration. Never prefix these secrets VITE_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only alias; the API safely falls back to VITE_SUPABASE_URL.
SUPABASE_URL=
# Exact application origin, with no path (for example https://app.dreamsheet.ai).
DREAMSHEET_APP_ORIGIN=

RESEND_API_KEY=
# Server-only, comma-separated administrator recipients.
ADMIN_ALERT_EMAILS=
# Production defaults to enabled; Preview requires true; Development stays disabled.
ADMIN_ALERTS_ENABLED=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
